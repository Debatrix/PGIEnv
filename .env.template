# API Keys for Remote Model Access
# Copy this file to .env and fill in your actual API keys

# OpenAI GPT Models
OPENAI_API_KEY=sk-your-openai-api-key-here

# Claude Models (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Qwen Models (Alibaba Cloud DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# Gemini Models (Google)
GEMINI_API_KEY=your-gemini-api-key-here

# Custom Deployment Models
CUSTOM_API_KEY=your-custom-api-key-here

# Locally hosted custom model server (consumed by pgibench/planner/custom_model.py;
# see scripts/local_model_server.py). Full /process endpoint URL.
server_url=http://localhost:23333/process
